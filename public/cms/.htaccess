Options -Indexes

<FilesMatch "^(content\.json|api\.php)$">
  Require all granted
</FilesMatch>

<FilesMatch "\.(bak|backup)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  <Files "content.json">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>
</IfModule>
